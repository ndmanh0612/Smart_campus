{
  "name": "smartcard-week1-rebuild",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file=.env server.ts",
    "start:prototype": "node --env-file=.env prototype-server.ts",
    "migrate": "node --env-file=.env migrate.ts",
    "seed": "node --env-file=.env seed.ts",
    "test:campus": "node --test --test-concurrency=1 test/campus.test.ts",
    "test:prototype": "node --test --test-concurrency=1 test/integration.test.ts",
    "check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "typescript": "5.9.3"
  }
}
